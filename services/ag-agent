# /etc/sudoers.d/ap-agent
# Allow pi to control only our AP services without password,
# and allow the minimal root commands needed by bundle install.

pi ALL=(root) NOPASSWD: \
  /usr/bin/systemctl start ap-agent.service, \
  /usr/bin/systemctl stop ap-agent.service, \
  /usr/bin/systemctl restart ap-agent.service, \
  /usr/bin/systemctl start ap-uploader.service, \
  /usr/bin/systemctl stop ap-uploader.service, \
  /usr/bin/systemctl restart ap-uploader.service, \
  /usr/bin/systemctl enable ap-agent.service, \
  /usr/bin/systemctl disable ap-agent.service, \
  /usr/bin/systemctl enable ap-uploader.service, \
  /usr/bin/systemctl disable ap-uploader.service, \
  /usr/bin/systemctl is-active ap-agent.service, \
  /usr/bin/systemctl is-active ap-uploader.service, \
  /usr/bin/systemctl status ap-agent.service, \
  /usr/bin/systemctl status ap-uploader.service, \
  /usr/bin/systemctl daemon-reload, \
  /bin/systemctl start ap-agent.service, \
  /bin/systemctl stop ap-agent.service, \
  /bin/systemctl restart ap-agent.service, \
  /bin/systemctl start ap-uploader.service, \
  /bin/systemctl stop ap-uploader.service, \
  /bin/systemctl restart ap-uploader.service, \
  /bin/systemctl enable ap-agent.service, \
  /bin/systemctl disable ap-agent.service, \
  /bin/systemctl enable ap-uploader.service, \
  /bin/systemctl disable ap-uploader.service, \
  /bin/systemctl is-active ap-agent.service, \
  /bin/systemctl is-active ap-uploader.service, \
  /bin/systemctl status ap-agent.service, \
  /bin/systemctl status ap-uploader.service, \
  /bin/systemctl daemon-reload, \
  /usr/bin/cp, \
  /bin/cp, \
  /usr/bin/mkdir, \
  /bin/mkdir, \
  /usr/bin/chown, \
  /bin/chown, \
  /usr/bin/chmod, \
  /bin/chmod, \
  /usr/sbin/visudo, \
  /sbin/visudo, \
  /usr/sbin/reboot, \
  /sbin/reboot