#!/bin/sh /etc/rc.common

START=98
STOP=11

USE_PROCD=1

SCRIPT="/opt/_RunScanner/ap_mcs_sampler_daemon"
NAME="ap-mcs-sampler"
PID_FILE="/var/run/mcs_sampler.pid"
OUTPUT_FILE="/tmp/mcs_distributions.json"

start_service() {
    # Check if traffic monitoring is enabled
    if [ ! -f "/opt/_RunScanner/ap_traffic_config.json" ]; then
        echo "Traffic config not found, not starting MCS sampler"
        return 0
    fi
    
    enabled=$(grep -o '"enabled"[[:space:]]*:[[:space:]]*true' /opt/_RunScanner/ap_traffic_config.json 2>/dev/null)
    if [ -z "$enabled" ]; then
        echo "Traffic monitoring disabled, not starting MCS sampler"
        return 0
    fi
    
    echo "Starting MCS sampler daemon"
    
    procd_open_instance
    procd_set_param command /bin/sh $SCRIPT
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param user root
    procd_set_param pidfile $PID_FILE
    procd_close_instance
}

stop_service() {
    echo "Stopping MCS sampler daemon"
    if [ -f "$PID_FILE" ]; then
        kill $(cat "$PID_FILE") 2>/dev/null || true
        rm -f "$PID_FILE"
    fi
    killall -9 ap_mcs_sampler_daemon 2>/dev/null || true
    rm -f "$OUTPUT_FILE"
}

reload_service() {
    stop
    start
}
