# Exact activation only. No arbitrary nmcli commands, shell, or password access.
pi ALL=(root) NOPASSWD: /usr/bin/nmcli --wait 12 connection up ifname wlP1p1s0
# sudo >= 1.9.10: fixed operation/interface, UUID and MAC arguments only.
pi ALL=(root) NOPASSWD: /usr/bin/nmcli ^--wait 12 connection up uuid [[:xdigit:]-]+ ifname wlP1p1s0 ap [[:xdigit:]][[:xdigit:]](\:[[:xdigit:]][[:xdigit:]]){5}$
pi ALL=(root) NOPASSWD: /usr/sbin/iw dev wlP1p1s0 scan dump, /usr/sbin/iw dev wlP1p1s0 scan trigger, /usr/sbin/iw ^dev wlP1p1s0 scan trigger freq [0-9]{4}( [0-9]{4})*$
