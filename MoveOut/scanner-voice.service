# /etc/systemd/system/scanner-voice.service
[Unit]
Description=Scanner Voice Service (Wave-2)
After=network-online.target sound.target graphical.target
Wants=network-online.target graphical.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/_RunScanner
ExecStart=/usr/bin/python3 /opt/_RunScanner/voice/voice_service.py
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/user/1000/.mutter-Xwaylandauth.4UOIK3

# Keep logs in our own file; systemd journal still has them too
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
